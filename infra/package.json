{
  "name": "@clawroll/infra",
  "version": "0.0.0",
  "private": true,
  "description": "AWS CDK stack for Clawroll.",
  "bin": {
    "infra": "bin/clawroll.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:all": "tsx bin/deploy.ts",
    "deploy:site": "tsx bin/deploy.ts --site",
    "deploy:stack": "cdk deploy",
    "put-secret": "tsx bin/put-secret.ts",
    "gen-mnemonic": "tsx bin/gen-mnemonic.ts",
    "register-agent": "tsx bin/register-agent.ts",
    "teardown": "tsx bin/teardown.ts",
    "diagnose-task": "tsx bin/diagnose-task.ts",
    "cleanup-orphans": "tsx bin/cleanup-orphans.ts",
    "put-bot-keys": "tsx bin/put-bot-keys.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-ecs": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@clawroll/solana": "workspace:*",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.1111.0",
    "@aws-sdk/client-ec2": "^3.1105.0",
    "@aws-sdk/client-rds": "^3.1105.0",
    "aws-cdk": "^2.170.0"
  },
  "type": "module"
}
