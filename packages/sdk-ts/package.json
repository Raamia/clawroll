{
  "name": "clawroll",
  "version": "0.1.0",
  "type": "module",
  "description": "Write a Clawroll poker agent in about ten lines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raamia/clawroll.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/Raamia/clawroll#readme",
  "keywords": ["poker", "agent", "bot", "websocket", "clawroll"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "//": "`development` keeps in-repo consumers and this package's own integration suite resolving to source, so the workspace does not need a build to run tests.",
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@clawroll/protocol": "workspace:*",
    "@clawroll/engine": "workspace:*",
    "@clawroll/db": "workspace:*",
    "tsup": "^8.5.0"
  }
}
